import cv2
import numpy as np
import matplotlib.pyplot as plt
from tensorflow.keras.models import load_model
from ultralytics import YOLO

# Load the U-Net segmentation model (Keras format)
seg_model = load_model("/content/drive/MyDrive/unet_model_with_lion.h5", compile=False)

# Load the YOLOv8 classification model (ONNX format)
cls_model = YOLO("/content/drive/MyDrive/runs/classify/train2/weights/best.onnx")

# Read and preprocess the image
image_path = "/content/drive/MyDrive/project-img/209522940-209522991-001.BMP"
image_bgr = cv2.imread(image_path)
image_rgb = cv2.cvtColor(image_bgr, cv2.COLOR_BGR2RGB)
image_resized = cv2.resize(image_rgb, (256, 256))

# Normalize for U-Net input
input_image = image_resized / 255.0
input_image = np.expand_dims(input_image, axis=0)

# Predict segmentation mask using U-Net
pred_mask = seg_model.predict(input_image)[0]
pred_mask = (pred_mask.squeeze() > 0.5).astype(np.uint8)

# Predict class using YOLOv8 classifier
cls_results = cls_model.predict(source=image_resized, imgsz=256, verbose=False)
probs = cls_results[0].probs
pred_class_index = probs.top1
pred_class_name = cls_model.names[pred_class_index]
confidence = probs.data[pred_class_index].item()

# Define cancerous classes
cancerous_classes = [
    "light_dysplastic",
    "moderate_dysplastic",
    "severe_dysplastic",
    "carcinoma_in_situ"
]

# Determine the final diagnosis
status = "Cancerous" if pred_class_name in cancerous_classes else "Non-Cancerous"

# Display results
plt.figure(figsize=(15, 5))

plt.subplot(1, 3, 1)
plt.imshow(image_resized)
plt.title("Input Image")
plt.axis("off")

plt.subplot(1, 3, 2)
plt.imshow(pred_mask, cmap='gray')
plt.title("Predicted Mask (U-Net)")
plt.axis("off")

plt.subplot(1, 3, 3)
plt.imshow(image_resized)
plt.imshow(pred_mask, cmap='Reds', alpha=0.5)
plt.title(f"{status}\nClass: {pred_class_name}\nConfidence: {confidence:.2f}")
plt.axis("off")

plt.tight_layout()
plt.show()
